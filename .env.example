# Copy file này thành .env và điền thông tin thật
# File .env KHÔNG push lên Git

# Platform: android hoặc ios
PLATFORM=android

# Android
ANDROID_DEVICE=emulator-5554
ANDROID_PLATFORM_VERSION=13.0

# iOS (điền khi có Mac)
IOS_DEVICE=iPhone 15
IOS_PLATFORM_VERSION=17.0
IOS_UDID=your-device-udid-here

# Appium Server
APPIUM_HOST=http://localhost:4723

# Tài khoản test Zing MP3 (KHÔNG dùng tài khoản thật)
ZING_TEST_EMAIL=test@example.com
ZING_TEST_PASSWORD=your_test_password
